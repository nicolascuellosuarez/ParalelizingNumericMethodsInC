set terminal png size 800,600
set output "speedup.png"
set xlabel "Numero de hilos"
set ylabel "Speedup"
set title "Speedup del metodo paralelo vs. numero de hilos"
set grid
set xrange [0.5:8.5]
set yrange [0:9]
plot "benchmark.dat" using 1:3 with linespoints lt 1 lw 2 pt 7 title "Speedup real", \
      x with lines lt 2 lw 2 title "Speedup ideal"